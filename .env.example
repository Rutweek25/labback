# Environment Configuration Template (Placeholders only - NO secrets)

NODE_ENV=production
PORT=5000
DATABASE_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/lab_db
JWT_SECRET=your_jwt_secret_min_12_chars
JWT_EXPIRES_IN=1d
CLIENT_URL=https://labmanagementpbn.netlify.app

# Resend Email Configuration (Server-Side Only)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=Lab Management <onboarding@resend.dev>

# Optional SMTP Fallback Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
